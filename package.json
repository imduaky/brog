{
  "name": "brog",
  "version": "0.1.0",
  "private": true,
  "description": "A git-backed blog: mkdocs-material style markdown, commit/push publishing, built-in git server.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "tsx watch --clear-screen=false src/server/main.ts",
    "dev:web": "vite",
    "build": "pnpm build:web && pnpm build:server",
    "build:web": "vite build",
    "build:server": "tsdown",
    "start": "node dist/server/main.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "reset-password": "tsx src/server/main.ts reset-password"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@mdit/plugin-abbr": "^1.1.3",
    "@mdit/plugin-attrs": "^1.3.4",
    "@mdit/plugin-dl": "^1.1.3",
    "@mdit/plugin-footnote": "^1.1.3",
    "@mdit/plugin-katex": "^1.1.4",
    "@mdit/plugin-mark": "^2.1.3",
    "@mdit/plugin-sub": "^1.1.3",
    "@mdit/plugin-sup": "^1.1.3",
    "@mdit/plugin-tasklist": "^1.1.4",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.13",
    "katex": "^0.19.1",
    "markdown-it": "^15.0.3",
    "markdown-it-anchor": "^10.0.0",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5",
    "shiki": "^4.5.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@uiw/react-codemirror": "^4.25.12",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.6",
    "lucide-react": "^1.61.0",
    "mermaid": "^12.2.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.23.2",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.24.0"
}
